# BeCoffee Database Configuration (MySQL or Supabase PostgreSQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=becoffee_db
DB_USER=root
DB_PASS=

# For Supabase PostgreSQL direct connection:
# DB_DRIVER=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.[project-ref]
# DB_PASS=[your-supabase-db-password]
# DB_SSLMODE=require

SESSION_SECRET=becoffee_secret_key_change_in_production_2026

# Supabase Cloud Integration (Object Storage & Email Auth)
# Find these in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=becoffee-storage

# Gmail / SMTP Email Verification Dispatch (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@becoffee.ph
SMTP_FROM_NAME="BeCoffee Specialty Roastery"
